# Copy this file to "config.mk" (which is git-ignored) and edit the path.
# Alternative: set a RAYLIB_DIR *environment variable* once and skip this file.
#
# RAYLIB_DIR must contain include/raylib.h and lib/libraylib.a
# Use FORWARD slashes and avoid spaces in the path.

RAYLIB_DIR := C:/raylib-5.5_win64_mingw-w64

# Only needed if your raylib has a different layout, e.g. the official
# Windows installer keeps raylib.h and libraylib.a together in "src":
# RAYLIB_INC := C:/raylib/raylib/src
# RAYLIB_LIB := C:/raylib/raylib/src
