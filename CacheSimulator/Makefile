# =============================================================================
#  Cache Memory Simulator - Makefile
#
#  Targets:   make            build build/CacheSimulator.exe
#             make run        build and launch
#             make test       build and run the automated tests (no raylib needed)
#             make clean      delete the build/ folder
#             make help       show the active configuration
#
#  Use "mingw32-make" instead of "make" if that is what your MinGW provides.
#
#  raylib location (nothing is hard-coded). Pick ONE of:
#    1. environment variable   RAYLIB_DIR=C:/path/to/raylib
#    2. a git-ignored file     config.mk   (copy config.mk.example)
#    3. command line           make RAYLIB_DIR=C:/path/to/raylib
#  RAYLIB_DIR must contain include/raylib.h and lib/libraylib.a.
#  Use forward slashes and no spaces. If your layout differs, set
#  RAYLIB_INC and RAYLIB_LIB separately.
# =============================================================================

-include config.mk

APP_NAME  := CacheSimulator
SRC_DIR   := src
INC_DIR   := include
BUILD_DIR := build

# "debug" (default) or "release". Run "make clean" when switching.
BUILD     ?= debug

ifeq ($(origin CC),default)
  CC := gcc
endif

RAYLIB_DIR ?=
RAYLIB_INC ?= $(RAYLIB_DIR)/include
RAYLIB_LIB ?= $(RAYLIB_DIR)/lib

# ---- Platform detection ------------------------------------------------------
# PLATFORM : windows if building natively on Windows or with a *mingw* compiler
# HOST_CMD : non-empty only when make runs commands through cmd.exe
#            (mingw32-make without sh.exe). Under MSYS2/w64devkit shells it
#            stays empty and POSIX commands are used.
PLATFORM := unsupported
HOST_CMD :=
ifeq ($(OS),Windows_NT)
  PLATFORM := windows
  ifneq ($(findstring Windows_NT,$(shell echo %OS%)),)
    HOST_CMD := 1
  endif
else ifneq ($(findstring mingw,$(CC)),)
  PLATFORM := windows
endif

# ---- Compiler and linker flags -----------------------------------------------
WARNINGS := -Wall -Wextra -Wpedantic -Wshadow
CFLAGS   := -std=c11 $(WARNINGS) -I$(INC_DIR) -I$(RAYLIB_INC) -MMD -MP
LDFLAGS  := -L$(RAYLIB_LIB)
# raylib on Windows needs OpenGL, GDI and the multimedia timer library.
LDLIBS   := -lraylib -lopengl32 -lgdi32 -lwinmm

ifeq ($(BUILD),release)
  CFLAGS  += -O2 -DNDEBUG
  LDFLAGS += -mwindows
else
  CFLAGS  += -g -O0
endif

# ---- Files -------------------------------------------------------------------
SRCS := $(wildcard $(SRC_DIR)/*.c)
OBJS := $(patsubst $(SRC_DIR)/%.c,$(BUILD_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)
EXE  := $(BUILD_DIR)/$(APP_NAME).exe

# ---- Rules -------------------------------------------------------------------
# Tests link every logic module but not the GUI, so they need no raylib.
LOGIC_SRCS  := $(filter-out $(SRC_DIR)/main.c $(SRC_DIR)/gui.c,$(SRCS))
TEST_SRC    := tests/test_cache.c
EXE_EXT     := $(if $(filter windows,$(PLATFORM)),.exe,)
TEST_EXE    := $(BUILD_DIR)/test_cache$(EXE_EXT)
TEST_CFLAGS := -std=c11 $(WARNINGS) -g -O0 -I$(INC_DIR)

.PHONY: all run test clean help check-raylib

all: $(EXE)

$(EXE): $(OBJS) | $(BUILD_DIR)
	$(CC) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.c | $(BUILD_DIR) check-raylib
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir $(BUILD_DIR)

# Fails early with an actionable message instead of a cryptic compiler error.
check-raylib:
ifeq ($(PLATFORM),unsupported)
	$(error This project targets Windows (MinGW-w64). Detected: not Windows)
endif
ifeq ($(wildcard $(RAYLIB_INC)/raylib.h),)
	$(error raylib.h not found in "$(RAYLIB_INC)" (RAYLIB_DIR is "$(RAYLIB_DIR)"). Set RAYLIB_DIR - see docs/SETUP_WINDOWS.md)
endif

$(TEST_EXE): $(TEST_SRC) $(LOGIC_SRCS) $(wildcard $(INC_DIR)/*.h) | $(BUILD_DIR)
	$(CC) $(TEST_CFLAGS) $(TEST_SRC) $(LOGIC_SRCS) -o $@

test: $(TEST_EXE)
ifneq ($(HOST_CMD),)
	$(subst /,\,$(TEST_EXE))
else
	./$(TEST_EXE)
endif

run: all
ifneq ($(HOST_CMD),)
	$(subst /,\,$(EXE))
else
	./$(EXE)
endif

clean:
ifneq ($(HOST_CMD),)
	-if exist $(BUILD_DIR) rmdir /S /Q $(BUILD_DIR)
else
	rm -rf $(BUILD_DIR)
endif

help:
	@echo CC         = $(CC)
	@echo BUILD      = $(BUILD)
	@echo PLATFORM   = $(PLATFORM)
	@echo RAYLIB_INC = $(RAYLIB_INC)
	@echo RAYLIB_LIB = $(RAYLIB_LIB)
	@echo SOURCES    = $(SRCS)

# Header-change tracking generated by -MMD (important with shared headers).
-include $(DEPS)
