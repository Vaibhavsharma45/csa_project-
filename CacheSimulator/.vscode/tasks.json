{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "mingw32-make",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run",
      "type": "shell",
      "command": "mingw32-make run",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "mingw32-make test",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "mingw32-make clean",
      "problemMatcher": []
    }
  ]
}
